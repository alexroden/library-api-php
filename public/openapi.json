                "tags": [
                    "HealthCheck"
                ],
                "summary": "API health check",
                "operationId": "755fc66ab7c26b533854649ff27d7f73",
                "responses": {
                    "200": {
                        "description": "OK response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
