{
  "name": "alexrode/libray-api-php",
  "license": "MIT",
  "description": "A training project in PHP to create an api for a library",
  "type": "project",
  "require": {
    "php": "^8.5",
    "vlucas/phpdotenv": "^5.6",
    "ext-pdo": "*",
    "symfony/var-dumper": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "AlexRoden\\LibraryApiPhp\\": "src/",
      "AlexRoden\\LibraryApiPhp\\Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "AlexRoden\\LibraryApiPhp\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
